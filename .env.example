# Copy this file to .env in the repository root (or to backend/.env if you
# prefer service-local envs). docker compose --env-file reads from the path
# you pass it. Values that have no default and are required are marked with
# ? in the compose files.

# -----------------------------------------------------------------------------
# Postgres
# -----------------------------------------------------------------------------

POSTGRES_USER=ocv
POSTGRES_PASSWORD=ocv_dev_password
POSTGRES_DB=ourcityvoice
# Port published to the host. The backend talks to "postgres:5432" on the
# compose network regardless of this value.
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Backend
# -----------------------------------------------------------------------------

# The schema rejects a missing JWT_SECRET at startup, so this has no default.
# Generate one with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME

# Comma-separated list of origins allowed by CORS. Include your frontend's
# origin.
CORS_ORIGINS=http://localhost:3000

# Logging verbosity.
LOG_LEVEL=debug

# Rate limiting
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MS=3600000

# Media uploads
# Comma-separated hostnames allowed in media URLs saved by the API. Wildcards
# are not supported; Cloudinary is the default because it fits the UploadWidget.
ALLOWED_MEDIA_HOSTS=res.cloudinary.com

# The backend binds to PORT inside the container. POST to the host uses
# BACKEND_PORT.
PORT=4000
BACKEND_PORT=4000

# Internal URL used by server-side Next.js to call the API. Inside docker
# compose "backend" resolves to the backend service; outside docker it would
# be http://localhost:${BACKEND_PORT}.
INTERNAL_API_URL=http://backend:4000/api/v1

# Browser-facing URL. The Next.js app is served on the host at NEXT_PUBLIC_PORT.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# The dev containers now run as root (see README) so host UID/GID no longer
# need to be passed to keep bind-mounted files writable. These are retained
# only so `docker compose build` outside ./dev.sh still works if somebody
# passes them.
HOST_UID=1000
HOST_GID=1000

# Gemini API (Google AI Studio)
GEMINI_API_KEY=
# Optional (defaults are already set)
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBED_MODEL=text-embedding-004

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------

# Port published to the host.
NEXT_PUBLIC_PORT=3000

# File upload (Cloudinary unsigned upload preset)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=CHANGE_ME
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=CHANGE_ME
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME

# Captcha (optional)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Google Maps (optional)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
