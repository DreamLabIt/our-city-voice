# Development environment. Copy to .env, then `./dev.sh up`.
#   cp .env.example .env
#
# docker compose reads this file automatically for variable substitution.
# These are development-only values, so they are safe to keep simple.

# ── postgres ────────────────────────────────────────────────────────
POSTGRES_USER=ocv
POSTGRES_PASSWORD=ocv_dev_password
POSTGRES_DB=ourcityvoice
# Host port. Change it if something else already owns 5432.
POSTGRES_PORT=5432

# ── backend ─────────────────────────────────────────────────────────
BACKEND_PORT=4000
LOG_LEVEL=debug
# Comma separated, no trailing slashes.
CORS_ORIGINS=http://localhost:3000

# ── auth ────────────────────────────────────────────────────────────
# Signs access tokens. No default in the schema, so the backend refuses to
# start without it. Generate one per environment:
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME

# How long an access token is good for. Short, because it is not checked
# against the database, so this is the window where a revoked account still
# works. 15 is a reasonable default.
ACCESS_TOKEN_TTL_MINUTES=15

# How long "stay signed in" lasts. Refresh tokens are stored hashed, rotated on
# every use, and revocable.
REFRESH_TOKEN_TTL_DAYS=30

# Hosts an avatar or media URL may point at, comma separated. Uploads go
# straight to Cloudinary, so this is the only one needed.
ALLOWED_MEDIA_HOSTS=res.cloudinary.com

# Prefix for a media storage key that is not already a URL or a /public path.
# Empty in development: fixtures hold paths, real uploads hold Cloudinary URLs.
MEDIA_BASE_URL=

# ── cloudinary ──────────────────────────────────────────────────────
# Used by the NEXT.JS SERVER only, to sign upload requests. The browser uploads
# straight to Cloudinary with a signature it is handed; the secret never leaves
# the server and is not NEXT_PUBLIC_ for exactly that reason.
#
# Dashboard -> Settings -> API Keys.
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME

# Everything uploaded lands under this folder, so avatars and report media are
# separable in the Cloudinary console. Subfolders are added per kind.
CLOUDINARY_FOLDER=ourcityvoice

# ── frontend ────────────────────────────────────────────────────────
FRONTEND_PORT=3000

# Where the BROWSER sends API requests. It resolves on your machine, so it is
# localhost, not a container name.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Where NEXT'S SERVER sends API requests (server components, route handlers).
# This resolves inside the docker network, so it is the service name.
# Getting these two mixed up is the most common first-week docker bug.
INTERNAL_API_URL=http://backend:4000/api/v1

# There is no container user to set here. The dev containers run as root,
# which rootless docker maps onto your own host user. See "The dev containers
# run as root" in the README.
