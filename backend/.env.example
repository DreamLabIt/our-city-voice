# Copy to .env for running the backend directly on the host.
# When you run through docker compose, values come from the root .env
# instead and this file is only a reference.

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Host-side connection. Inside docker the host is "postgres", not "localhost".
DATABASE_URL=postgresql://ocv:ocv_dev_password@localhost:5432/ourcityvoice

# Comma separated. No trailing slashes.
CORS_ORIGINS=http://localhost:3000

# Signs access tokens. Required; there is no default, so a missing value stops
# the server at boot instead of shipping a known key.
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Hosts an avatar or media URL in a request body is allowed to point at.
ALLOWED_MEDIA_HOSTS=res.cloudinary.com

# Failed sign-in attempts per IP per window before the endpoint answers 429.
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000

SHUTDOWN_TIMEOUT_MS=10000
