# Only needed when running the frontend directly on the host with
# `pnpm dev`. Through docker compose these come from the root .env instead.
#
#   cp .env.example .env.local

# Browser-side. NEXT_PUBLIC_* is inlined into the client bundle at build
# time, so it is public by definition. Never put a secret behind this prefix.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Server-side only (server components, route handlers). Outside docker this
# is the same host; inside docker it is http://backend:4000/api/v1.
INTERNAL_API_URL=http://localhost:4000/api/v1

# ── cloudinary ──────────────────────────────────────────────────────
# Server-side only. The browser uploads straight to Cloudinary, but it does so
# with a signature this server generates, so the secret stays here.
#
# Note what is NOT prefixed with NEXT_PUBLIC_: all of it. NEXT_PUBLIC_ values
# are inlined into the JavaScript the browser downloads, so putting the API
# secret behind that prefix would publish it.
#
# Dashboard -> Settings -> API Keys.
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME
CLOUDINARY_FOLDER=ourcityvoice
