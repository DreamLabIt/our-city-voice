# Development environment. Copy to .env, then `./dev.sh up`.
#   cp .env.example .env
#
# docker compose reads this file automatically for variable substitution.
# These are development-only values, so they are safe to keep simple.

# ── postgres ────────────────────────────────────────────────────────
POSTGRES_USER=ocv
POSTGRES_PASSWORD=ocv_dev_password
POSTGRES_DB=ourcityvoice
# Host port. Change it if something else already owns 5432.
POSTGRES_PORT=5432

# ── backend ─────────────────────────────────────────────────────────
BACKEND_PORT=4000
LOG_LEVEL=debug
# Comma separated, no trailing slashes.
CORS_ORIGINS=http://localhost:3000

# ── frontend ────────────────────────────────────────────────────────
FRONTEND_PORT=3000

# Where the BROWSER sends API requests. It resolves on your machine, so it is
# localhost, not a container name.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Where NEXT'S SERVER sends API requests (server components, route handlers).
# This resolves inside the docker network, so it is the service name.
# Getting these two mixed up is the most common first-week docker bug.
INTERNAL_API_URL=http://backend:4000/api/v1
