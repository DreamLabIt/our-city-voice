{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],

    /* NodeNext is what makes this real ESM. The price is that every
       relative import needs an explicit .js extension, even though the
       file on disk is .ts. That is not a typo, it is how Node resolves
       ESM: the extension refers to the compiled output. */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "verbatimModuleSyntax": true,

    "rootDir": "src",
    "outDir": "dist",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
