# Production environment for the VPS. Copy to .env.prod on the server:
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
#
# .env.prod is gitignored and must never be committed. Fill it in on the
# server, not on your laptop.

# ── postgres ────────────────────────────────────────────────────────
POSTGRES_USER=ocv
# Generate one: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ourcityvoice

# ── backend ─────────────────────────────────────────────────────────
LOG_LEVEL=info

# Every origin allowed to call the API, comma separated, no trailing slashes.
# While the frontend is on Vercel, put its production URL here. Preview
# deployments get a new URL per commit and are NOT auto-allowed in production.
CORS_ORIGINS=https://ourcityvoice.example.com

# Signs access tokens. Generate a fresh one for the server; do not reuse the
# development value. Rotating it signs everybody out, which is the point.
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
ALLOWED_MEDIA_HOSTS=res.cloudinary.com

# ── cloudinary ──────────────────────────────────────────────────────
# Read by the Next.js server at runtime. None of these are NEXT_PUBLIC_, so
# they are not baked into the image and can be changed with a restart.
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME
CLOUDINARY_FOLDER=ourcityvoice

# ── frontend ────────────────────────────────────────────────────────
# Baked into the client bundle at image build time. Changing it needs a
# rebuild, not a restart.
NEXT_PUBLIC_API_URL=https://api.ourcityvoice.example.com/api/v1
INTERNAL_API_URL=http://backend:4000/api/v1

# ── nginx ───────────────────────────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443
