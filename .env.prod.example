# Production environment for the VPS. Copy to .env.prod on the server:
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
#
# .env.prod is gitignored and must never be committed. Fill it in on the
# server, not on your laptop.

# ── postgres ────────────────────────────────────────────────────────
POSTGRES_USER=ocv
# Generate one: openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=ourcityvoice

# ── backend ─────────────────────────────────────────────────────────
LOG_LEVEL=info

# Every origin allowed to call the API, comma separated, no trailing slashes.
# While the frontend is on Vercel, put its production URL here. Preview
# deployments get a new URL per commit and are NOT auto-allowed in production.
CORS_ORIGINS=https://ourcityvoice.example.com

# ── frontend ────────────────────────────────────────────────────────
# Baked into the client bundle at image build time. Changing it needs a
# rebuild, not a restart.
NEXT_PUBLIC_API_URL=https://api.ourcityvoice.example.com/api/v1
INTERNAL_API_URL=http://backend:4000/api/v1

# ── nginx ───────────────────────────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443
